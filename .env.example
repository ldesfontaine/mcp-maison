# ===== Serveur =====
# "production" interdit AUTH_DEV_TOKENS. Le Dockerfile et docker-compose.yml le fixent déjà.
NODE_ENV=
PORT=3000
HOST=0.0.0.0
# Noms d'hôte acceptés (anti DNS rebinding), séparés par des virgules. Recommandé en prod.
ALLOWED_HOSTS=
# Taille max d'une requête (fichiers publiés inclus)
MAX_BODY=10mb
# Derrière un reverse proxy : nombre de proxys de confiance (ex. 1), ou true / false
TRUST_PROXY=

# ===== Identité (docs/identite.md) =====
# --- OIDC : la seule voie en production (GitLab, Keycloak, Authentik…) ---
# URL publique HTTPS de CE serveur, sans /mcp. Callback à déclarer chez l'IdP : ${MCP_PUBLIC_URL}/oauth/callback
MCP_PUBLIC_URL=
# Issuer exact de l'IdP, ex. https://gitlab.example.com ou https://auth.example.com/realms/equipe
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Scopes demandés et claim de userinfo qui porte les groupes
OIDC_SCOPES="openid profile email"
OIDC_GROUPS_CLAIM=groups
# Optionnel : qui peut se connecter (vide = tout compte de l'IdP). Identifiants, et/ou groupes.
OIDC_ALLOWED_USERS=
OIDC_ALLOWED_GROUPS=
# Adresses de retour acceptées pour les clients (DCR), URL exacte ou "http://hôte:*". Vide : Claude + boucle locale.
OAUTH_REDIRECT_ALLOWLIST=

# --- Jetons de développement : tests et poste local seulement, refusés si NODE_ENV=production ---
# identifiant:jeton séparés par des virgules ; jeton = openssl rand -hex 32. Une valeur d'exemple est refusée.
# Ex. : AUTH_DEV_TOKENS=lucas:<sortie de openssl rand -hex 32>
AUTH_DEV_TOKENS=

# ===== Données =====
DATABASE_PATH=./data/mcp-maison.db
AUDIT_LOG_PATH=./data/audit.jsonl
# Droits (docs/droits.md). Vide : ./permissions.yaml s'il existe, sinon droits minimaux (ping, whoami).
PERMISSIONS_FILE=

# ===== Outils (docs/ajouter-une-integration.md) =====
# Groupes activés. Un groupe dont la config manque est ignoré avec un avertissement.
TOOL_GROUPS=core,gitlab

# --- Groupe gitlab : publication de pages statiques ---
GITLAB_URL=https://gitlab.example.com
# ID numérique ou "groupe/projet"
GITLAB_PROJECT_ID=
# Token de projet, scope "api", rôle Developer, push autorisé sur la branche : c'est lui qui pousse
GITLAB_TOKEN=
GITLAB_BRANCH=main
# Là où la CI du dépôt publie <slug>/
GITLAB_PUBLISH_BASE_URL=https://demo.example.com

# --- Groupe opencloud : lecture d'openCloud (machines, conteneurs, sondes, alertes…), à ajouter à TOOL_GROUPS ---
# URL d'openCloud, sans /api : https, ou http en boucle locale ou vers une IP privée (10/8, 172.16/12 dont 172.17.0.1, 192.168/16)
# Hôte : une IP, localhost ou le nom de public_url d'openCloud ; tout autre Host reçoit 403 bad_host (anti DNS
# rebinding) : un nom de conteneur ou host.docker.internal ne marchent pas
OPENCLOUD_URL=
# Jeton d'API d'openCloud, portée read : c'est lui que l'API croit ; l'appelant n'est qu'indiqué (X-MCP-Maison-User)
OPENCLOUD_TOKEN=
# Délai d'un appel, en millisecondes
OPENCLOUD_TIMEOUT_MS=10000

