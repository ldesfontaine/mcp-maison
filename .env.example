# ===== Serveur =====
PORT=3000
HOST=0.0.0.0
# Noms d'hôte acceptés (anti DNS rebinding), séparés par des virgules. Recommandé en prod.
ALLOWED_HOSTS=
# Taille max d'une requête (fichiers publiés inclus)
MAX_BODY=10mb
# Derrière un reverse proxy : nombre de proxys de confiance (ex. 1)
TRUST_PROXY=

# ===== Identité (docs/identite.md) =====
# "tokens" (un jeton par personne, perso/dev) ou "oauth" (connexion via un IdP, claude.ai Team)
AUTH_MODE=tokens

# identifiant:token séparés par des virgules ; token = openssl rand -hex 32.
# Acceptés aussi en mode oauth (scripts, lecture de /audit).
MCP_TOKENS=lucas:remplacer-par-openssl-rand-hex-32

# --- Mode oauth ---
# URL publique HTTPS de CE serveur, sans /mcp. Callback à déclarer chez l'IdP : ${MCP_PUBLIC_URL}/oauth/callback
MCP_PUBLIC_URL=https://mcp.example.com
# gitlab (scopes read_user + openid) ou oidc (Keycloak, Authentik, Google…)
OAUTH_PROVIDER=gitlab
# gitlab : URL de l'instance (https://gitlab.example.com) ; oidc : l'issuer exact
OAUTH_ISSUER=https://gitlab.example.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# oidc seulement : scopes demandés et claim qui porte les groupes
# OAUTH_SCOPES=openid profile email
# OAUTH_GROUPS_CLAIM=groups
# Optionnel : qui peut se connecter (vide = tout compte de l'IdP). Usernames, et/ou groupes.
OAUTH_ALLOWED_USERS=
OAUTH_ALLOWED_GROUPS=

# ===== Données =====
DATABASE_PATH=./data/mcp-maison.db
AUDIT_LOG_PATH=./data/audit.jsonl
# Droits (docs/droits.md). Vide : ./permissions.yaml s'il existe, sinon tout le monde a tout.
PERMISSIONS_FILE=

# ===== Outils (docs/ajouter-une-integration.md) =====
# Groupes activés. Un groupe dont la config manque est ignoré avec un avertissement.
TOOL_GROUPS=core,gitlab

# --- Groupe gitlab : publication de maquettes ---
GITLAB_URL=https://gitlab.example.com
# ID numérique ou "groupe/projet"
GITLAB_PROJECT_ID=123
# Token de projet, scope "api", rôle Developer, push autorisé sur la branche : c'est lui qui pousse
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_BRANCH=main
# Là où la CI du dépôt publie <slug>/
GITLAB_PUBLISH_BASE_URL=https://demo.example.com

# --- Groupe opencloud : lectures ---
# Adresse publique d'openCloud (sans /mcp) et jeton d'API créé dans openCloud, Paramètres > MCP
OPENCLOUD_URL=
OPENCLOUD_TOKEN=
